[Unit]
Description=F2K_CUDA web UI (Flask front-end)
After=network.target f2k-worker.service
Wants=f2k-worker.service

[Service]
Type=simple
User=chris
Group=chris
Environment=HOME=/home/chris
Environment=F2K_WORKER_PORT=8765
# Put F2K_WEB_PASSWORD (and optionally F2K_WEB_USER) here; '-' = optional file.
EnvironmentFile=-/home/chris/.config/f2k-web.env
WorkingDirectory=/home/chris/Documents/Development/Cpp/Projects/F2KTest
ExecStart=/home/chris/Documents/Development/Cpp/Projects/F2KTest/.venv/bin/python tools/webui/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
